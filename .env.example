# ===== App =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
BUSINESS_NAME=Relist
BUSINESS_ADDRESS="123 Main St, Wilmington, DE 19801"
SUPPORT_EMAIL=support@relist.ai
ADMIN_EMAIL=jack@seifdn.org

# ===== Supabase / Drizzle =====
# Prefer the Supavisor transaction pooler (port 6543) for serverless —
# Project Settings → Database → "Connection pooling" → "Transaction" mode.
# postgresql://postgres.PROJECTREF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ===== Clerk (admin auth only) =====
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/admin/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/admin

# ===== Stripe =====
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# ===== Inngest =====
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ===== Apify (scraping) =====
APIFY_TOKEN=
APIFY_ZILLOW_ACTOR=maxcopell/zillow-scraper
APIFY_REDFIN_ACTOR=tugkan/redfin-scraper
APIFY_REALTOR_ACTOR=epctex/realtor-scraper

# ===== fal.ai (cheap preview generation) =====
FAL_API_KEY=
FAL_PREVIEW_MODEL=fal-ai/nano-banana-pro

# ===== REimagineHome (paid staging) =====
# Swappable — see lib/staging-api.ts
REIMAGINEHOME_API_KEY=
REIMAGINEHOME_BASE_URL=https://api.reimaginehome.ai
STAGING_PROVIDER=reimaginehome

# ===== Anthropic (Claude Haiku — email drafting + reply triage) =====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ===== OpenAI (GPT-4o-mini — vision scoring + QC gate) =====
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# ===== Resend (email) =====
RESEND_API_KEY=
RESEND_INBOUND_WEBHOOK_SECRET=
# Comma-separated list of warmed sender domains for round-robin rotation
SENDER_DOMAINS=relist.ai,hello.relist.ai,team.getrelist.com
SENDER_FROM_NAME=Relist

# ===== Twilio (post-engagement SMS only — see TCPA guardrail in lib/twilio.ts) =====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ===== Cloudflare R2 =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=merchant-photos
R2_PUBLIC_URL=https://photos.relist.ai

# ===== PostHog =====
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_API_KEY=

# ===== Zilla parent Meta — shared across every sub-company =====
# These are the IDs of the ONE Zilla Business Portfolio that owns every
# child ad account, Page, IG account, and Pixel. They never change.
# They are safe to commit because:
#   - BP IDs appear in URLs (not credentials)
#   - App IDs ship in client-side SDKs
#   - System User IDs are useless without the paired token
# Day-0 provisioning runbook: architecture/docs/01a-meta-sub-company-replication.md
# Operator one-pager:          ZILLA_HQ_SETUP_META.md
ZILLA_PARENT_BUSINESS_ID=1952475115474490
ZILLA_META_APP_ID=1281372737395331
ZILLA_SYSTEM_USER_ID=61589373840437

# Never-expiring System User access token. NEVER commit this — pull it
# from Vercel:
#   vercel link              # one-time, links local repo to the Vercel project
#   vercel env pull .env.local
# That command writes ZILLA_SYSTEM_USER_TOKEN (and every other secret)
# straight into .env.local, which is gitignored. If you don't have
# Vercel access, ask Jack to add you to the Zilla-HQ team.
ZILLA_SYSTEM_USER_TOKEN=

# ===== Meta — Pixel + Conversions API + Marketing API (per-merchant) =====
# These are the CHILD assets — one Pixel, one ad account, one Page, one
# IG per merchant. They are minted by the platform onboarding script
# (lib/meta-platform.ts → createSubCompanyMetaAssets) at sub-company
# creation time, NOT by hand. The script writes them straight into the
# merchant's Vercel env, so a fresh fork's .env.local will be populated
# by `vercel env pull` after onboarding completes — no manual entry.
#
# Pixel ID is exposed to the browser for the client-side Pixel; CAPI token is
# server-only. The Marketing API token (system user, ads_management scope) is
# what the Inngest jobs use to read insights and pause/resume campaigns.
NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
META_TEST_EVENT_CODE=
META_API_VERSION=v19.0
# Numeric ad account id, no `act_` prefix
META_AD_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=
# Numeric Facebook Page ID — every ad runs "from" a Page. Required for video
# uploads + ad creative shares. System User must be assigned to this Page.
META_PAGE_ID=

# Autonomy thresholds (USD). Pause campaigns where CAC > target after MIN_SPEND.
META_TARGET_CAC_USD=75
META_PURCHASE_VALUE_USD=199
META_MIN_SPEND_USD=50

# ===== Meta — Lead-CAC budget scaler (OUTCOME_LEADS campaign) =====
# See META_ADS.md for the full playbook. Scaler runs daily, derives target
# budget from days-since-launch (+20% every 3 days), caps at MAX, pauses if
# last-7d CAC > ceiling after MIN_SPEND.
META_LEAD_CAMPAIGN_ID=
META_LEAD_LAUNCH_DATE=
META_LEAD_INITIAL_BUDGET_CENTS=7500
META_LEAD_MAX_BUDGET_CENTS=20000
META_LEAD_CAC_CEILING_EARLY=7
META_LEAD_CAC_CEILING_STEADY=5
META_LEAD_MIN_SPEND=50
META_LEAD_FATIGUE_FREQUENCY=2.5

# Ad set IDs — needed by scripts/meta-create-ads.ts when building ads.
META_LEAD_ADSET_A_ID=
META_LEAD_ADSET_B_ID=
# Latest video creative ID (output of scripts/meta-upload-page-video.ts).
META_VIDEO_ID=

# Kill switch for the lead-scaler + fatigue-check Inngest crons.
CRON_LEAD_SCALER_ENABLED=true

# ===== Operator alerts (lib/operator-alerts.ts) =====
# Where hot-lead notifications go ("[Heat: 🔥] Acme replied"). Comma-separated.
OPERATOR_NOTIFY_EMAIL=
# Optional override for the From address; defaults to RESEND_FROM_ADDRESS.
OPERATOR_ALERT_FROM=

# ===== Founder / early-bird promo (used by reply-handler auto-replies) =====
# Set both to inject the promo into "interested" + "price_question" auto-replies.
# 10-20% conversion lift documented from time-bounded discount mentions.
FOUNDER_PROMO_CODE=
FOUNDER_PROMO_DESCRIPTION=

# ===== Post-purchase customize token (lib/customize-token.ts) =====
# 32+ random chars. Rotating this invalidates every existing customize link —
# only rotate if you suspect compromise.
CUSTOMIZE_SECRET=

# ===== Email enrichment backfill cron =====
# Per-run cap to keep Hunter / Apollo quota predictable. Re-trigger manually
# until the no-email-yet backlog is empty; never schedule on a cron.
BACKFILL_EMAILS_MAX_PER_RUN=100

# ===== Click-tracking allowlist =====
# Hosts /api/track/click/[id] is allowed to redirect to. Defaults to
# NEXT_PUBLIC_APP_URL only. Add more comma-separated hosts to allow them
# (e.g. checkout subdomain, partner sites).
TRACK_CLICK_ALLOWED_HOSTS=

# ===== Dual-auth secret for admin endpoints (lib/admin-auth.ts) =====
# Same secret used by Vercel Cron headers. Send as `x-admin-secret` or
# `Authorization: Bearer <secret>` to bypass Clerk for cron-driven admin ops.
CRON_SECRET=

# ===== Operational caps =====
DAILY_SEND_CAP=500
PREVIEW_DAILY_CAP=500
FULFILLMENT_DAILY_BUDGET_CENTS=100000

# Pricing (overridable in admin settings; these are bootstrap defaults)
PRICING_STANDARD_CENTS=7900
PRICING_PREMIUM_CENTS=14900
PRICING_RUSH_CENTS=19900

# ===== SEO — sitemap, GSC, Bing, IndexNow (see SEO.md) =====
# Google Search Console verification token. Operator gets this from
# search.google.com/search-console → Add property → URL prefix →
# HTML tag → copy the content="..." value here. Drops a meta tag in
# <head> via app/layout.tsx → metadata.verification.google.
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# IndexNow key (Bing/Yandex/Naver real-time indexation). Generate ONCE
# per merchant fork via:
#   node scripts/generate-indexnow-key.mjs
# That script also writes public/<key>.txt — commit both.
NEXT_PUBLIC_INDEXNOW_KEY=

# Bing Webmaster Tools verification token. Optional — committed XML
# file (public/BingSiteAuth.xml) is what Bing actually reads. Generated
# via:
#   BING_TOKEN=<token> node scripts/generate-bing-auth-file.mjs
NEXT_PUBLIC_BING_VERIFICATION_TOKEN=

# ===== Zilla HQ shared SEO credentials (autonomous bootstrap) =====
# Set these to enable automatic GSC + Bing property registration via
# Inngest cron + admin panel at /admin/seo. See ZILLA_HQ_SETUP.md for
# the one-time provisioning. These four env vars are SHARED across all
# Zilla merchants — paste them unchanged from the platform vault.
ZILLA_GSC_OAUTH_CLIENT_ID=
ZILLA_GSC_OAUTH_CLIENT_SECRET=
ZILLA_GSC_OAUTH_REFRESH_TOKEN=
ZILLA_BING_WEBMASTER_API_KEY=

# Optional per-merchant override — only needed for apex-domain merchants
# (sitebeat.tech, realscale.app, etc.) that want autonomous bootstrap on
# their own apex. Mint via scripts/zilla-mint-gsc-refresh-token.mjs but
# signed in as the apex-domain owner. Overrides ZILLA_GSC_OAUTH_REFRESH_TOKEN.
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=

# ===== X (Twitter) — autonomous brand-account post + auto-reply (see X.md) =====

# Zilla HQ-shared OAuth 2.0 confidential-client credentials. One X dev
# app at the Zilla HQ level powers every merchant's brand account, the
# same way ZILLA_GSC_OAUTH_* powers every merchant's Search Console
# bootstrap. See ZILLA_HQ_SETUP_X.md for one-time provisioning.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Per-merchant brand-prompt for the auto-reply Claude call. Used by
# lib/x-mentions-handler.ts to build the system prompt. Without these
# the handler falls back to a generic SMB persona.
X_BRAND_NAME=
X_BRAND_HANDLE=
# Multi-line description: what the brand does, when to reply / not reply,
# what link to drop, what discount code (if any) to mention. Pasted
# directly into the system prompt. Keep under ~1000 chars.
X_BRAND_ABOUT=

# Optional override for the per-run reply cap (default 5). Each reply
# burns ~$0.001 Anthropic + 1 unit of X tweet quota.
X_MENTIONS_MAX_REPLIES_PER_RUN=

# Anthropic key + model used to evaluate mentions (and reused elsewhere
# in the codebase). Without ANTHROPIC_API_KEY the X cron skips silently.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

