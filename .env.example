# MenuLift environment variables.
#
# All real secrets live in Vercel (encrypted env vars), not in git.
# To reproduce locally: `vercel env pull .env.local` after running
# `vercel link --project menulift`.
#
# Order roughly mirrors when each integration gets used in the user flow.

# ─── Public site config ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://menulift.app
BUSINESS_NAME=MenuLift
BUSINESS_ADDRESS=Sei Development Foundation, 419 Lafayette St. 8th Floor, New York, NY 10003

# ─── Transactional email (Resend) — confirmation send ──────────────
# Account: https://resend.com → API keys
# Sender domain must be DNS-verified in Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDER_DOMAINS=menulift.app                   # comma-separated; first one is primary
SENDER_FROM_NAME=MenuLift
REPLIES_EMAIL=hello@menulift.app

# ─── Analytics (PostHog) ────────────────────────────────────────────
# Account: https://us.posthog.com → Project settings → API keys
# Server key (POSTHOG_PROJECT_API_KEY) and client key (NEXT_PUBLIC_POSTHOG_KEY)
# are intentionally the same project token — captures from both sides
# fan into the same project.
POSTHOG_PROJECT_API_KEY=phx_xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_KEY=phx_xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Payments (Stripe) — checkout for paid menu shoots ─────────────
# Account: https://dashboard.stripe.com → Developers → API keys
# Use sk_test_* for development. sk_live_* in production only when
# real charges are intended.
STRIPE_SECRET_KEY=sk_test_or_sk_live_xxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_or_pk_live_xxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Database (Supabase / Postgres + Drizzle) ──────────────────────
# Account: https://supabase.com/dashboard → Project → Settings → Database
# Use the pooled connection string (port 6543) for serverless on Vercel.
# SUPABASE_ACCESS_TOKEN is the Personal Access Token used by the management
# API (project provisioning), separate from the per-project DATABASE_URL.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx

# ─── Object storage (Cloudflare R2) — generated photos ─────────────
# Account: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET=menulift-photos
R2_PUBLIC_URL=https://cdn.menulift.app           # custom domain on the bucket

# ─── AI generation (fal.ai + Anthropic) ─────────────────────────────
# fal.ai for image generation (food photography). Anthropic for recipe
# interpretation, prompt assembly, reply triage.
FAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Admin auth (Clerk) — operator dashboard ───────────────────────
# Account: https://dashboard.clerk.com → App → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_or_pk_live_xxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_or_sk_live_xxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/admin/sign-up
ADMIN_EMAIL=ops@menulift.app
ADMIN_EMAIL_DOMAINS=seifdn.org,seinetwork.io,menulift.app

# ─── Workflow runtime (Inngest) ─────────────────────────────────────
INNGEST_EVENT_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INNGEST_SIGNING_KEY=signkey-xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Meta (Facebook/Instagram) — Pixel, CAPI, Marketing API ────────
# Pixel + CAPI: client-side tracking + server-side dedupe. Ad-account
# autonomy lives behind META_ADS_ACCESS_TOKEN (Marketing API).
NEXT_PUBLIC_META_PIXEL_ID=xxxxxxxxxxxxxxxx
META_CONVERSIONS_API_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxx
META_ADS_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxx
META_AD_ACCOUNT_ID=xxxxxxxxxxxxxxxx                    # numeric, no act_ prefix
META_API_VERSION=v19.0
META_TARGET_CAC_USD=40
META_PURCHASE_VALUE_USD=79
META_MIN_SPEND_USD=20

# ─── Google Ads — branded defense + Search ─────────────────────────
# HQ-shared OAuth client + refresh token (reused across Zilla merchants).
# Per-merchant customer ID + conversion ID is unique.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=3797064633
GOOGLE_ADS_DEVELOPER_TOKEN=xxxxxxxxxxxxxxxxxxxxxx
GOOGLE_ADS_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxx
GOOGLE_ADS_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_ADS_CUSTOMER_ID=xxxxxxxxxx                       # per-merchant ad account
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-xxxxxxxxxx

# ─── Caps / autonomy thresholds ────────────────────────────────────
DAILY_SEND_CAP=200
PREVIEW_DAILY_CAP=100
FULFILLMENT_DAILY_BUDGET_CENTS=5000
